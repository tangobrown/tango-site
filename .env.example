# Contact form delivery via Postmark (see app/actions/contact.ts).
# Set these in Vercel → Settings → Environment Variables, and in .env.local
# for local development.
#
# Server API token from your Postmark server:
POSTMARK_SERVER_TOKEN=
# A verified Sender Signature / domain address you send FROM:
POSTMARK_FROM_EMAIL=
# Where enquiries are delivered (defaults to tim@tangobrown.com if unset):
CONTACT_TO_EMAIL=tim@tangobrown.com
